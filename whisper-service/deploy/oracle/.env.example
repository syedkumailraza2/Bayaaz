# Public hostname for the STT service (A record → this VM's public IP).
STT_DOMAIN=stt.mybayaaz.com
# Shared secret — set the SAME value as STT_TOKEN on the Render backend.
# Generate with: openssl rand -hex 32
STT_TOKEN=change-me

# Optional tuning (defaults shown)
# STT_THREADS=0              # 0 = one decoder thread per CPU core
# STT_MAX_STREAMS=0          # 0 = threads * 8
# STT_PARTIAL_INTERVAL_MS=300
# STT_MAX_BACKLOG_SECONDS=3
# STT_MAX_ACTIVE=4000
# STT_BEAM=11
