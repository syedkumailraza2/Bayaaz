# Unified STT service — Vosk WS at /ws + Whisper HTTP at /transcribe.
# One FastAPI process, one bind port, both protocols served at the same URL.

PORT=5001
HOST=0.0.0.0

# Path to an unzipped Vosk model directory.
VOSK_MODEL_PATH=./vosk-model-small-hi-0.22

# Default sample rate for WS clients that don't send a config frame.
VOSK_SAMPLE_RATE=16000

# faster-whisper size: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base
