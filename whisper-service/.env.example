# Unified STT service — Vosk WS at /ws + Vosk batch at /transcribe.
# One FastAPI process, one bind port, both protocols served at the same URL.

PORT=5001
HOST=0.0.0.0

# Path to an unzipped Vosk model directory.
VOSK_MODEL_PATH=./vosk-model-small-hi-0.22

# Default sample rate for WS clients that don't send a config frame.
VOSK_SAMPLE_RATE=16000

# Shared secret required in the X-STT-Token header (/ws and /transcribe).
# Leave empty for local dev; ALWAYS set on a public host, and set the same
# value as STT_TOKEN on the backend.
STT_TOKEN=

# Performance tuning (defaults shown)
# STT_THREADS=0              # decoder threads; 0 = CPU count
# STT_MAX_STREAMS=0          # concurrent /ws streams; 0 = threads * 8
# STT_PARTIAL_INTERVAL_MS=300
# STT_MAX_BACKLOG_SECONDS=3
# STT_MAX_ACTIVE=4000        # decoder search width (model default 7000)
# STT_BEAM=11                # (model default 13)
